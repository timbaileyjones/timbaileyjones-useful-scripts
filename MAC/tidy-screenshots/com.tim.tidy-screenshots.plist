<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tim.tidy-screenshots</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/tim/.local/bin/tidy-screenshots</string>
        <string>rename</string>
    </array>
    <key>WatchPaths</key>
    <array>
        <string>/Users/tim/Desktop</string>
    </array>
    <key>ThrottleInterval</key>
    <integer>1</integer>
    <key>StandardOutPath</key>
    <string>/Users/tim/Library/Logs/tidy-screenshots.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/tim/Library/Logs/tidy-screenshots.log</string>
</dict>
</plist>
